# Шаблон окружения для приватного API (api/).
# Скопируйте в api/.env и заполните нужное. Все переменные необязательные:
# без них сервер поднимается в режиме `echo` и всё равно проверяет доступ.

# --- сеть ---
HOST=0.0.0.0
PORT=8787

# --- доступ ---
# Белый список адресов через запятую. По умолчанию — один адрес.
ALLOWED_EMAILS=babaevafarida8@gmail.com
# Секрет подписи производных ключей. ОБЯЗАТЕЛЬНО смените на боевом сервере.
HIKKO_API_SECRET=hikko-dev-secret-change-me
# Готовый статический ключ (способ входа №1). Пусто — используется производный ключ.
HIKKO_API_KEY=
# Включает POST /api/v1/admin/token (выпуск ключей).
ADMIN_TOKEN=
# Вход по заголовку X-Hikko-Email: true/false. В NODE_ENV=production по умолчанию false.
ALLOW_HEADER_AUTH=true

# --- модель (одно из двух; если ничего не задано — режим echo) ---
# Ключи Google AI Studio, можно несколько через запятую — перебор как в edge-функции chat.
GEMINI_API_KEYS=
# Или любой OpenAI-совместимый шлюз (например, Lovable AI Gateway).
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- проверка Supabase JWT (способ входа №3) ---
# Если пусто, возьмутся VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY из корневого .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- лимиты и промпт ---
# Незнакомый model в запросе (Cline/Cursor подставляют свой id): true — молча
# берём DEFAULT_MODEL, false — отвечаем 400.
ALLOW_UNKNOWN_MODEL=true
RATE_LIMIT_PER_MINUTE=600
MAX_BODY_BYTES=1000000
UPSTREAM_TIMEOUT_MS=120000
DEFAULT_MODEL=hikko-gpt
HIKKO_SYSTEM_PROMPT=
