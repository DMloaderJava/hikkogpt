{
  "//": "Конфиг только для приватного API в api/. Фронтенд проверяется tsconfig.app.json.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["api/**/*.ts"],
  "//exclude": "react-hook.tsx — шаблон для src/ (алиас @/ и JSX), проверяется в составе приложения. openai-sdk.ts — пример с SDK openai (пакет есть в devDependencies, но пример не часть сервера).",
  "exclude": ["api/examples/react-hook.tsx", "api/examples/openai-sdk.ts"]
}
